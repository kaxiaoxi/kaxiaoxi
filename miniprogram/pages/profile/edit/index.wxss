.tip {
  padding: 16rpx 8rpx 24rpx;
  font-size: 24rpx;
  color: var(--s-2);
  line-height: 1.6;
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 0 28rpx;
  margin-bottom: 24rpx;
}

.field {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--sep);
}

.field:last-child {
  border-bottom: none;
}

.field__label {
  font-size: 26rpx;
  color: var(--s-2);
}

.field__input {
  margin-top: 8rpx;
  font-size: 30rpx;
  height: 52rpx;
  line-height: 52rpx;
}

.field__input--placeholder {
  color: var(--s-3);
}

.reason {
  padding: 24rpx 28rpx;
}

.textarea {
  margin-top: 12rpx;
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.footer {
  margin-top: 16rpx;
}
