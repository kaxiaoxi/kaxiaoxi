<view class="page">
  <view class="section">年度管理</view>
  <view class="card">
    <view class="row" bindtap="onYear">
      <text>学年管理</text>
      <view class="row__right">
        <text class="row__value">{{year}}</text>
        <text class="row__arrow">›</text>
      </view>
    </view>
    <view class="row" bindtap="onAppoint">
      <text>任命主席 / 部长</text>
      <view class="row__right">
        <text class="row__value">{{appointText}}</text>
        <text class="row__arrow">›</text>
      </view>
    </view>
    <view class="row" bindtap="onMembers">
      <text>成员管理</text>
      <view class="row__right">
        <text class="row__value">待审 {{pendingCount}}</text>
        <text class="row__arrow">›</text>
      </view>
    </view>
  </view>

  <view class="section">其他</view>
  <view class="card">
    <view class="row" bindtap="onAbout">
      <text>关于与反馈</text>
      <text class="row__arrow">›</text>
    </view>
    <view class="row">
      <text>当前版本</text>
      <text class="row__value">v1.1.0</text>
    </view>
  </view>

  <view class="tip">年度管理里都是低频操作：一学年切换一次、换届时任命、平时审核成员。</view>
</view>
