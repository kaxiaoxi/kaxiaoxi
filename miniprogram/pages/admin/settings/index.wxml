<view class="page">
  <view class="section">学年</view>
  <view class="card">
    <view class="line">
      <text>当前学年</text>
      <text class="value">{{year}}</text>
    </view>
    <view class="line">
      <text>下一学年</text>
      <input class="input" value="{{nextYear}}" bindinput="onNextYear" />
    </view>
    <button class="btn btn--ghost btn-top" bindtap="onArchive">切换学年</button>
  </view>

  <view class="section">主席移交</view>
  <view class="card">
    <view class="line">
      <text>当前主席</text>
      <text class="value">{{chairmanName}}</text>
    </view>
    <view class="line">
      <text>新主席学号</text>
      <input class="input" type="number" maxlength="10" placeholder="10 位学号" value="{{studentNo}}" bindinput="onStudentNo" />
    </view>
    <button class="btn btn--ghost btn-top" bindtap="onTransfer">移交</button>
  </view>

  <view class="tip">移交后原主席自动变为部长；学年切换只改统计口径，不会删除历史数据。</view>
</view>
