.section {
  margin: 24rpx 8rpx 16rpx;
  font-size: 28rpx;
  color: var(--s-2);
  font-weight: 600;
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 8rpx 28rpx 28rpx;
}

.line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--sep);
  font-size: 28rpx;
}

.value {
  color: var(--s-2);
}

.input {
  text-align: right;
  font-size: 28rpx;
  width: 280rpx;
}

.btn-top {
  margin-top: 28rpx;
}

.tip {
  margin: 24rpx 8rpx;
  font-size: 22rpx;
  color: var(--s-3);
  line-height: 1.6;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx 0 8rpx;
}

.chip {
  display: flex;
  flex-direction: column;
  padding: 14rpx 24rpx;
  border-radius: 32rpx;
  background: #f2f2f7;
}

.chip--on {
  background: var(--blue);
}

.chip__name {
  font-size: 26rpx;
  color: var(--ink);
}

.chip--on .chip__name {
  color: #fff;
  font-weight: 600;
}

.chip__sub {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--s-2);
}

.chip--on .chip__sub {
  color: rgba(255, 255, 255, 0.8);
}

.muted {
  display: block;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: var(--s-2);
}
