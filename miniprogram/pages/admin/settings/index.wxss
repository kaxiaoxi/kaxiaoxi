.section {
  margin: 28rpx 8rpx 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--s-2);
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 0 28rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--sep);
  font-size: 30rpx;
}

.row:last-child {
  border-bottom: none;
}

.row__right {
  display: flex;
  align-items: center;
}

.row__value {
  font-size: 26rpx;
  color: var(--s-2);
}

.row__arrow {
  margin-left: 12rpx;
  color: var(--s-3);
}

.tip {
  margin: 28rpx 8rpx;
  font-size: 22rpx;
  color: var(--s-3);
  line-height: 1.6;
}
