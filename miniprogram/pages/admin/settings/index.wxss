.section {
  margin: 24rpx 8rpx 16rpx;
  font-size: 28rpx;
  color: var(--s-2);
  font-weight: 600;
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 8rpx 28rpx 28rpx;
}

.line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--sep);
  font-size: 28rpx;
}

.value {
  color: var(--s-2);
}

.input {
  text-align: right;
  font-size: 28rpx;
  width: 280rpx;
}

.btn-top {
  margin-top: 28rpx;
}

.tip {
  margin: 24rpx 8rpx;
  font-size: 22rpx;
  color: var(--s-3);
  line-height: 1.6;
}

.avatar-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx 12rpx;
  padding: 24rpx 0 8rpx;
}

.avatar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-box {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  border: 4rpx solid transparent;
  box-sizing: border-box;
  padding: 2rpx;
}

.avatar-item--on .avatar-box {
  border-color: var(--blue);
}

.avatar-img {
  width: 84rpx;
  height: 84rpx;
  border-radius: 42rpx;
  display: block;
}

.avatar-text {
  width: 84rpx;
  height: 84rpx;
  border-radius: 42rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-check {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: var(--blue);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fff;
}

.avatar-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.avatar-dept {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: var(--s-3);
}
