.section {
  margin: 24rpx 8rpx 16rpx;
  font-size: 28rpx;
  color: var(--s-2);
  font-weight: 600;
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 8rpx 28rpx 28rpx;
}

.line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--sep);
  font-size: 28rpx;
}

.value {
  color: var(--s-2);
}

.input {
  text-align: right;
  font-size: 28rpx;
  width: 280rpx;
}

.btn-top {
  margin-top: 28rpx;
}

.tip {
  margin: 24rpx 8rpx;
  font-size: 22rpx;
  color: var(--s-3);
  line-height: 1.6;
}

.member-list {
  max-height: 520rpx;
  padding-bottom: 8rpx;
  box-sizing: border-box;
}

.member {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--sep);
}

.member:last-child {
  border-bottom: none;
}

.member--disabled {
  opacity: 0.45;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--s-3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.checkbox--on {
  background: var(--blue);
  border-color: var(--blue);
}

.member__main {
  flex: 1;
  min-width: 0;
}

.member__name {
  font-size: 28rpx;
  font-weight: 600;
}

.member__tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--s-2);
}

.member__sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--s-2);
}
