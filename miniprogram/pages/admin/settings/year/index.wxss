.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 0 28rpx;
  margin-top: 24rpx;
}

.line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--sep);
  font-size: 30rpx;
}

.line:last-child {
  border-bottom: none;
}

.value {
  color: var(--s-2);
}

.input {
  text-align: right;
  font-size: 28rpx;
  width: 280rpx;
}

.btn-top {
  margin-top: 32rpx;
}

.tip {
  margin: 24rpx 8rpx;
  font-size: 22rpx;
  color: var(--s-3);
  line-height: 1.6;
}
