.section {
  margin: 24rpx 8rpx 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.empty {
  text-align: center;
}

.member {
  margin-bottom: 20rpx;
}

.member__head {
  display: flex;
  align-items: center;
}

.member__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.member__info {
  margin-left: 24rpx;
}

.member__name {
  font-size: 32rpx;
  font-weight: 600;
}

.member__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.member__btn {
  flex: 1;
  height: 76rpx;
  font-size: 28rpx;
}
