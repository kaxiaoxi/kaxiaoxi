<view class="page">
  <view class="head">
    <text class="head__title">消息</text>
    <text class="head__read" bindtap="onReadAll">全部已读</text>
  </view>

  <view class="empty" wx:if="{{!loading && !list.length}}">暂无消息</view>

  <view class="list">
    <view
      class="row {{item.read ? '' : 'row--unread'}}"
      wx:for="{{list}}"
      wx:key="_id"
      data-id="{{item._id}}"
      data-read="{{item.read}}"
      bindtap="onRead"
    >
      <view class="dot" wx:if="{{!item.read}}"></view>
      <view class="row__main">
        <view class="row__top">
          <text class="row__title">{{item.title}}</text>
          <text class="row__time">{{item.timeText}}</text>
        </view>
        <view class="row__content">{{item.content}}</view>
      </view>
    </view>
  </view>
</view>
