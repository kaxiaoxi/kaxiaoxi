.hero {
  padding: 16rpx 8rpx 32rpx;
}

.hero__title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero__tags {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.tag--gray {
  background: rgba(118, 118, 128, 0.12);
  color: var(--s-2);
}

.tag--gold {
  background: rgba(217, 164, 65, 0.18);
  color: #9a6b12;
}

.row {
  display: flex;
  padding: 16rpx 0;
}

.row__key {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--s-2);
}

.row__value {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.6;
}

.section {
  margin: 32rpx 8rpx 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.desc {
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.participants {
  display: flex;
  flex-wrap: wrap;
  gap: 28rpx;
}

.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar__name {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--s-2);
}

.placeholder {
  height: 180rpx;
}

.bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(249, 249, 249, 0.96);
  border-top: 1rpx solid var(--sep);
}

.bottom__btn {
  flex: 1;
  width: auto;
}

.btn--disabled {
  background: #f1f2f4;
  color: #a9b1b9;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
}

.manage {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--blue);
}

.manage__arrow {
  color: var(--s-3);
}

.bottom {
  display: flex;
  gap: 20rpx;
}

.section__extra {
  font-size: 24rpx;
  color: var(--s-2);
  font-weight: 400;
}
