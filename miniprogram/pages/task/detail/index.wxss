.detail-page {
  padding-top: 18rpx;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.hero {
  padding: 14rpx 8rpx 34rpx;
}

.hero__eyebrow {
  color: var(--s-2);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.hero__title {
  margin-top: 12rpx;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.28;
  letter-spacing: -1rpx;
}

.hero__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.tag--gray {
  color: var(--s-2);
  background: rgba(118, 118, 128, 0.12);
}

.tag--gold {
  color: var(--gold);
  background: var(--gold-soft);
}

.manage {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.manage:active {
  opacity: 0.7;
}

.manage__title {
  color: var(--blue);
  font-size: 29rpx;
  font-weight: 700;
}

.manage__sub {
  margin-top: 5rpx;
  color: var(--s-2);
  font-size: 21rpx;
}

.manage__arrow {
  color: var(--s-3);
  font-size: 38rpx;
}

.facts {
  padding-top: 10rpx;
  padding-bottom: 10rpx;
}

.row {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--sep);
}

.row:last-child {
  border-bottom: none;
}

.row__key {
  width: 150rpx;
  flex-shrink: 0;
  color: var(--s-2);
  font-size: 25rpx;
}

.row__value {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
}

.description {
  padding-top: 28rpx;
  padding-bottom: 28rpx;
}

.description__text {
  color: var(--ink-2);
  font-size: 28rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-word;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 14rpx;
  margin: 34rpx 8rpx 14rpx;
}

.section-head__title {
  font-size: 30rpx;
  font-weight: 700;
}

.section-head__meta {
  color: var(--s-2);
  font-size: 21rpx;
  text-align: right;
}

.empty {
  min-height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.participants {
  display: flex;
  flex-wrap: wrap;
  gap: 26rpx 30rpx;
}

.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  color: #fff;
  font-size: 27rpx;
}

.avatar__name {
  margin-top: 8rpx;
  color: var(--s-2);
  font-size: 21rpx;
}

.placeholder {
  height: 60rpx;
}

.bottom {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  gap: 14rpx;
  padding: 12rpx;
  border-radius: 32rpx;
}

.bottom__btn {
  flex: 1;
  width: auto;
  height: 88rpx;
  margin: 0;
  border-radius: 23rpx;
  font-size: 28rpx;
}

.btn--disabled {
  background: rgba(241, 242, 244, 0.72);
  color: #77777c;
}

.error-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-top: 80rpx;
}

.error-card__title {
  font-size: 32rpx;
  font-weight: 700;
}

.error-card__text {
  margin-top: 10rpx;
  color: var(--s-2);
  font-size: 25rpx;
  line-height: 1.55;
}

.error-card__btn {
  width: 230rpx;
  height: 76rpx;
  margin: 26rpx 0 0;
  border-radius: 21rpx;
  font-size: 26rpx;
}

.detail-skeleton {
  padding: 20rpx 8rpx;
}

.detail-skeleton__title,
.detail-skeleton__tags,
.detail-skeleton__card,
.detail-skeleton__line {
  border-radius: 18rpx;
  background: linear-gradient(
    100deg,
    rgba(255, 255, 255, 0.7) 25%,
    rgba(255, 255, 255, 0.96) 42%,
    rgba(255, 255, 255, 0.7) 60%
  );
  background-size: 240% 100%;
  animation: skeleton-shift 1.4s ease-in-out infinite;
}

.detail-skeleton__title {
  width: 72%;
  height: 76rpx;
}

.detail-skeleton__tags {
  width: 52%;
  height: 40rpx;
  margin-top: 22rpx;
}

.detail-skeleton__card {
  height: 340rpx;
  margin-top: 36rpx;
}

.detail-skeleton__line {
  width: 88%;
  height: 32rpx;
  margin-top: 30rpx;
}

.detail-skeleton__line--short {
  width: 62%;
  margin-top: 16rpx;
}

@keyframes skeleton-shift {
  from {
    background-position: 100% 0;
  }

  to {
    background-position: -100% 0;
  }
}

.sheet-summary {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 22rpx;
  background: rgba(242, 242, 247, 0.72);
}

.sheet-summary--compact {
  padding: 20rpx 22rpx;
}

.sheet-summary__title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.sheet-summary__meta {
  margin-top: 7rpx;
  color: var(--s-2);
  font-size: 23rpx;
}

.sheet-row {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.08);
  font-size: 25rpx;
  line-height: 1.55;
}

.sheet-row__key {
  width: 92rpx;
  flex: 0 0 92rpx;
  color: var(--s-2);
}

.sheet-row__value {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-weight: 500;
  word-break: break-word;
}

.sheet-notice {
  margin-bottom: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  color: var(--blue);
  background: var(--blue-soft);
  font-size: 23rpx;
  line-height: 1.6;
}

.sheet-field {
  margin-top: 8rpx;
}

.sheet-field__label {
  margin-bottom: 10rpx;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
}

.sheet-textarea {
  width: 100%;
  height: 220rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(60, 60, 67, 0.12);
  border-radius: 20rpx;
  box-sizing: border-box;
  color: var(--ink);
  background: rgba(255, 255, 255, 0.92);
  font-size: 27rpx;
  line-height: 1.6;
}

.sheet-textarea__placeholder {
  color: #77777c;
}

.sheet-field__counter {
  margin-top: 8rpx;
  color: var(--s-2);
  font-size: 21rpx;
  text-align: right;
}

.sheet-pick {
  margin-bottom: 20rpx;
}

.sheet-pick__label {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: var(--s-2);
}

.sheet-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.sheet-chip {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  background: #f2f2f7;
  font-size: 24rpx;
  color: var(--ink);
}

.sheet-chip--on {
  background: var(--blue);
  color: #fff;
  font-weight: 600;
}

.role-stats {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.role-stat {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.role-stat__name {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
}

.role-stat__list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 20rpx;
}

.role-stat__item {
  font-size: 24rpx;
  color: var(--s-2);
}
