.page {
  height: 100vh;
  padding: 24rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.section {
  margin: 28rpx 8rpx 14rpx;
  font-size: 28rpx;
  color: var(--s-2);
  font-weight: 600;
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 8rpx 28rpx;
}

.field {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--sep);
}

.field:last-child {
  border-bottom: none;
}

.field--row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field__label {
  font-size: 26rpx;
  color: var(--s-2);
}

.field__input {
  margin-top: 8rpx;
  font-size: 30rpx;
  height: 52rpx;
  line-height: 52rpx;
}

.field__input--right {
  margin-top: 0;
  text-align: right;
  width: 160rpx;
}

.field__textarea {
  margin-top: 8rpx;
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.hint {
  padding: 8rpx 0 14rpx;
  font-size: 22rpx;
  color: var(--s-3);
}

.session__head {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0 4rpx;
  font-size: 26rpx;
}

.session__no {
  font-weight: 600;
}

.session__del {
  color: #b4392c;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}

.session__sep {
  font-size: 24rpx;
  color: var(--s-2);
}

.picker {
  background: #f2f3f5;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
}

.add {
  margin-top: 16rpx;
  padding: 22rpx 0;
  text-align: center;
  background: #fff;
  border-radius: var(--radius);
  color: var(--blue);
  font-size: 28rpx;
  font-weight: 600;
}

.seg {
  display: flex;
  background: rgba(118, 118, 128, 0.12);
  border-radius: 14rpx;
  padding: 4rpx;
  margin-top: 12rpx;
}

.seg__item {
  flex: 1;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  border-radius: 12rpx;
  color: var(--ink-2);
}

.seg__item--on {
  background: #fff;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.depts {
  display: flex;
  gap: 32rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--sep);
}

.dept {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
}

.footer {
  margin-top: 48rpx;
}

.field--switch {
  align-items: center;
}

.hint--inline {
  margin-top: 4rpx;
}

.role-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--sep);
}

.role-row__name {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #f2f2f7;
  font-size: 26rpx;
}

.role-row__quota {
  width: 140rpx;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #f2f2f7;
  font-size: 26rpx;
  text-align: center;
}

.role-row__del {
  flex-shrink: 0;
  color: #c0392b;
  font-size: 24rpx;
}

.role-add {
  margin-top: 16rpx;
  padding: 20rpx 0;
  text-align: center;
  border-radius: 16rpx;
  background: #f2f2f7;
  color: var(--blue);
  font-size: 26rpx;
}

.footer {
  display: flex;
  gap: 16rpx;
}

.footer__btn {
  flex: 1;
  width: auto;
  margin: 0;
}

.field__value {
  font-size: 28rpx;
  color: var(--ink);
}

.field__value--placeholder {
  color: var(--s-3);
}

.type-trigger__arrow {
  margin-left: 12rpx;
  color: var(--s-3);
  font-size: 32rpx;
}

.type-options {
  display: flex;
  flex-direction: column;
}

.type-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid var(--sep);
  font-size: 29rpx;
  color: var(--ink);
}

.type-option:last-child {
  border-bottom: none;
}

.type-option--on {
  color: var(--blue);
  font-weight: 600;
}

.type-option__check {
  color: var(--blue);
  font-size: 28rpx;
  font-weight: 700;
}
