<scroll-view class="page" scroll-y>
  <view class="section">活动类型</view>
  <view class="card">
    <picker mode="selector" range="{{typeOptions}}" value="{{typeIndex}}" bindchange="onTypeChange">
      <view class="field field--row">
        <text class="field__label">活动类型</text>
        <view class="field__value {{typeIndex < 0 ? 'field__value--placeholder' : ''}}">
          {{typeIndex >= 0 ? typeOptions[typeIndex] : '请选择活动类型'}}
        </view>
      </view>
    </picker>
    <view class="hint">地点、收图方式已取消，统一从预设类型中选择</view>
  </view>

  <view class="section">场次（可多天多时段）</view>
  <view class="card" wx:for="{{sessions}}" wx:key="key">
    <view class="session__head">
      <text class="session__no">第 {{index + 1}} 场</text>
      <text class="session__del" data-index="{{index}}" bindtap="onRemoveSession">删除</text>
    </view>
    <view class="row">
      <picker mode="date" value="{{item.date}}" data-index="{{index}}" data-field="date" bindchange="onSessionChange">
        <view class="picker">{{item.date}}</view>
      </picker>
      <picker mode="time" value="{{item.start}}" data-index="{{index}}" data-field="start" bindchange="onSessionChange">
        <view class="picker">{{item.start}}</view>
      </picker>
      <text class="session__sep">至</text>
      <picker mode="time" value="{{item.end}}" data-index="{{index}}" data-field="end" bindchange="onSessionChange">
        <view class="picker">{{item.end}}</view>
      </picker>
    </view>
  </view>
  <view class="add" bindtap="onAddSession">＋ 添加场次</view>

  <view class="section">人数与二课</view>
  <view class="card">
    <view class="field field--row">
      <text class="field__label">需要人数</text>
      <input
        class="field__input field__input--right"
        type="number"
        placeholder="不限"
        disabled="{{useRoles}}"
        data-field="quota"
        value="{{form.quota}}"
        bindinput="onInput"
      />
    </view>
    <view class="hint" wx:if="{{!useRoles}}">留空或填 0 表示不限人数</view>
    <view class="hint" wx:else>已按各分工人数自动汇总（每场）</view>
    <view class="field field--row">
      <text class="field__label">每场二课学时</text>
      <input
        class="field__input field__input--right"
        type="number"
        data-field="erkeHours"
        value="{{form.erkeHours}}"
        bindinput="onInput"
      />
    </view>
    <view class="hint">整数，按报名的场次累计；填 0 表示不计二课</view>

    <view class="field field--row field--switch">
      <view>
        <view class="field__label">按分工报名</view>
        <view class="hint hint--inline">开启后每个时段按分工单独计名额</view>
      </view>
      <switch checked="{{useRoles}}" color="#2E5F7E" bindchange="onToggleRoles" />
    </view>

    <block wx:if="{{useRoles}}">
      <view class="role-row" wx:for="{{roles}}" wx:key="index">
        <input
          class="role-row__name"
          placeholder="分工名，如摄影"
          value="{{item.name}}"
          data-index="{{index}}"
          data-field="name"
          bindinput="onRoleInput"
        />
        <input
          class="role-row__quota"
          type="number"
          placeholder="人数"
          value="{{item.quota}}"
          data-index="{{index}}"
          data-field="quota"
          bindinput="onRoleInput"
        />
        <text class="role-row__del" data-index="{{index}}" bindtap="onRemoveRole">删除</text>
      </view>
      <view class="role-add" bindtap="onAddRole">＋ 添加分工</view>
    </block>
  </view>

  <view class="section">报名设置</view>
  <view class="card">
    <view class="field">
      <view class="field__label">报名方式</view>
      <view class="seg">
        <view class="seg__item {{form.signupMode === 'first_come' ? 'seg__item--on' : ''}}" data-mode="first_come" bindtap="onSignupMode">先到先得</view>
        <view class="seg__item {{form.signupMode === 'review' ? 'seg__item--on' : ''}}" data-mode="review" bindtap="onSignupMode">报名审核</view>
      </view>
    </view>

    <view class="field">
      <view class="field__label">报名开放</view>
      <view class="seg">
        <view class="seg__item {{startMode === 'now' ? 'seg__item--on' : ''}}" data-mode="now" bindtap="onStartMode">立即</view>
        <view class="seg__item {{startMode === 'scheduled' ? 'seg__item--on' : ''}}" data-mode="scheduled" bindtap="onStartMode">定时</view>
      </view>
    </view>

    <view class="row" wx:if="{{startMode === 'scheduled'}}">
      <picker mode="date" value="{{startDate}}" bindchange="onStartDate">
        <view class="picker">{{startDate}}</view>
      </picker>
      <picker mode="time" value="{{startTime}}" bindchange="onStartTime">
        <view class="picker">{{startTime}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="field__label">报名截止</view>
      <view class="row">
        <picker mode="date" value="{{deadlineDate}}" bindchange="onDeadlineDate">
          <view class="picker">{{deadlineDate}}</view>
        </picker>
        <picker mode="time" value="{{deadlineTime}}" bindchange="onDeadlineTime">
          <view class="picker">{{deadlineTime}}</view>
        </picker>
      </view>
      <view class="hint">需早于或等于首场开始</view>
    </view>

    <view class="field">
      <view class="field__label">可见范围</view>
      <view class="seg">
        <view class="seg__item {{form.audience === 'depts' ? 'seg__item--on' : ''}}" data-mode="depts" bindtap="onAudience">指定部门</view>
        <view class="seg__item {{form.audience === 'all' ? 'seg__item--on' : ''}}" data-mode="all" bindtap="onAudience">全体</view>
      </view>
    </view>

    <checkbox-group wx:if="{{form.audience === 'depts'}}" bindchange="onDeptChange" class="depts">
      <label class="dept" wx:for="{{deptOptions}}" wx:key="key">
        <checkbox value="{{item.key}}" color="#2E5F7E" />
        <text>{{item.label}}</text>
      </label>
    </checkbox-group>
  </view>

  <view class="footer">
    <button
      class="btn btn--ghost footer__btn"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="onSubmit"
    >发布</button>
    <button
      class="btn btn--primary footer__btn"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      data-share="1"
      bindtap="onSubmit"
    >发布并分享</button>
  </view>
</scroll-view>
