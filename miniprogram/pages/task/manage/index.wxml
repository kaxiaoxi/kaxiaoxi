<view class="page">
  <view class="summary" wx:if="{{task}}">
    <view class="summary__title">{{task.title}}</view>
    <view class="summary__meta">
      已通过 {{task.approvedCount}}{{task.quota ? ' / ' + task.quota : ''}} · 候补 {{task.waitlistCount}}
    </view>
  </view>

  <view class="seg">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="seg__item {{tab === item.key ? 'seg__item--on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTab"
    >{{item.label}} {{item.count}}</view>
  </view>

  <view class="empty" wx:if="{{!current.length}}">暂无记录</view>

  <block wx:if="{{tab === 'pending'}}">
    <view class="card person" wx:for="{{current}}" wx:key="signupId">
      <view class="person__head">
        <image wx:if="{{item.avatarFileID}}" class="avatar" src="{{item.avatarUrl || item.avatarFileID}}" mode="aspectFill" lazy-load="{{true}}" style="background: {{item.avatarColor}}" data-id="{{item.signupId}}" binderror="onAvatarError" />
        <view wx:else class="avatar" style="background: {{item.avatarColor}}">{{item.avatarText}}</view>
        <view class="person__info">
          <view class="person__name">{{item.name}}</view>
          <view class="muted">{{item.dept}} · {{item.phone}}</view>
        </view>
      </view>
      <view class="note" wx:if="{{item.note}}">备注：{{item.note}}</view>
      <view class="actions">
        <button class="btn btn--ghost act" data-id="{{item.signupId}}" data-action="reject" bindtap="onReview">拒绝</button>
        <button class="btn btn--primary act" data-id="{{item.signupId}}" data-action="approve" bindtap="onReview">通过</button>
      </view>
    </view>
  </block>

  <block wx:if="{{tab === 'approved'}}">
    <view class="card person" wx:for="{{current}}" wx:key="signupId">
      <view class="person__head">
        <image wx:if="{{item.avatarFileID}}" class="avatar" src="{{item.avatarUrl || item.avatarFileID}}" mode="aspectFill" lazy-load="{{true}}" style="background: {{item.avatarColor}}" data-id="{{item.signupId}}" binderror="onAvatarError" />
        <view wx:else class="avatar" style="background: {{item.avatarColor}}">{{item.avatarText}}</view>
        <view class="person__info">
          <view class="person__name">{{item.name}}</view>
          <view class="muted">{{item.dept}} · {{item.phone}}</view>
        </view>
        <text class="remove" data-id="{{item.signupId}}" bindtap="onRemove">移出</text>
      </view>
    </view>
  </block>

  <block wx:if="{{tab === 'waitlisted'}}">
    <view class="card person" wx:for="{{current}}" wx:key="signupId">
      <view class="person__head">
        <image wx:if="{{item.avatarFileID}}" class="avatar" src="{{item.avatarUrl || item.avatarFileID}}" mode="aspectFill" lazy-load="{{true}}" style="background: {{item.avatarColor}}" data-id="{{item.signupId}}" binderror="onAvatarError" />
        <view wx:else class="avatar" style="background: {{item.avatarColor}}">{{item.avatarText}}</view>
        <view class="person__info">
          <view class="person__name">{{item.name}}</view>
          <view class="muted">{{item.dept}} · 候补第 {{index + 1}} 位</view>
        </view>
        <text class="remove" data-id="{{item.signupId}}" bindtap="onRemove">移出</text>
      </view>
    </view>
  </block>

  <block wx:if="{{tab === 'leave'}}">
    <view class="card person" wx:for="{{current}}" wx:key="signupId">
      <view class="person__head">
        <image wx:if="{{item.avatarFileID}}" class="avatar" src="{{item.avatarUrl || item.avatarFileID}}" mode="aspectFill" lazy-load="{{true}}" style="background: {{item.avatarColor}}" data-id="{{item.signupId}}" binderror="onAvatarError" />
        <view wx:else class="avatar" style="background: {{item.avatarColor}}">{{item.avatarText}}</view>
        <view class="person__info">
          <view class="person__name">{{item.name}}</view>
          <view class="muted">{{item.dept}} · {{item.phone}}</view>
        </view>
      </view>
      <view class="note">请假原因：{{item.leaveReason}}</view>
      <view class="actions">
        <button class="btn btn--ghost act" data-id="{{item.leaveRequestId}}" data-action="reject" bindtap="onReviewLeave">拒绝</button>
        <button class="btn btn--primary act" data-id="{{item.leaveRequestId}}" data-action="approve" bindtap="onReviewLeave">准假</button>
      </view>
    </view>
  </block>
</view>

<bottom-sheet
  visible="{{sheet.visible}}"
  title="{{sheet.title}}"
  description="{{sheet.description}}"
  confirm-text="{{sheet.confirmText}}"
  danger="{{sheet.danger}}"
  loading="{{sheetLoading}}"
  bind:close="onCloseSheet"
  bind:confirm="confirmSheet"
>
  <view class="sheet-person" wx:if="{{sheet.member}}">
    <image
      wx:if="{{sheet.member.avatarFileID}}"
      class="sheet-person__avatar"
      src="{{sheet.member.avatarFileID}}"
      mode="aspectFill"
    />
    <view
      wx:else
      class="sheet-person__avatar"
      style="background: {{sheet.member.avatarColor}}"
    >{{sheet.member.avatarText}}</view>
    <view class="sheet-person__meta">
      <view class="sheet-person__name">{{sheet.member.name}}</view>
      <view class="sheet-person__sub">
        {{sheet.member.dept}}<text wx:if="{{sheet.member.phone}}"> · {{sheet.member.phone}}</text>
      </view>
    </view>
  </view>

  <view class="sheet-reason" wx:if="{{sheet.type === 'leave'}}">
    <view class="sheet-reason__label">请假原因</view>
    <view class="sheet-reason__text">{{sheet.member.leaveReason}}</view>
  </view>

  <view class="sheet-warning" wx:if="{{sheet.type === 'remove'}}">
    <view class="sheet-warning__title">请确认移出后果</view>
    <view class="sheet-warning__text">
      该成员将不再计入本任务二课；若活动尚未开始，候补名单会自动递补。
    </view>
  </view>
</bottom-sheet>
