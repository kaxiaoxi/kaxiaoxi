.summary {
  padding: 16rpx 8rpx 24rpx;
}

.summary__title {
  font-size: 36rpx;
  font-weight: 700;
}

.summary__meta {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--s-2);
}

.seg {
  display: flex;
  background: rgba(118, 118, 128, 0.12);
  border-radius: 16rpx;
  padding: 4rpx;
}

.seg__item {
  flex: 1;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--ink-2);
  border-radius: 12rpx;
}

.seg__item--on {
  background: #fff;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: var(--s-2);
  font-size: 26rpx;
}

.person {
  margin-top: 20rpx;
}

.person__head {
  display: flex;
  align-items: center;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.person__info {
  margin-left: 20rpx;
  flex: 1;
}

.person__name {
  font-size: 30rpx;
  font-weight: 600;
}

.muted {
  font-size: 24rpx;
  color: var(--s-2);
}

.note {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--s-2);
  line-height: 1.6;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.act {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
}

.remove {
  font-size: 24rpx;
  color: #b4392c;
}
