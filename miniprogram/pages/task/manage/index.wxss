.summary {
  padding: 16rpx 8rpx 24rpx;
}

.summary__title {
  font-size: 36rpx;
  font-weight: 700;
}

.summary__meta {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--s-2);
}

.seg {
  display: flex;
  background: rgba(118, 118, 128, 0.12);
  border-radius: 16rpx;
  padding: 4rpx;
}

.seg__item {
  flex: 1;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--ink-2);
  border-radius: 12rpx;
}

.seg__item--on {
  background: #fff;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: var(--s-2);
  font-size: 26rpx;
}

.person {
  margin-top: 20rpx;
}

.person__head {
  display: flex;
  align-items: center;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.person__info {
  margin-left: 20rpx;
  flex: 1;
}

.person__name {
  font-size: 30rpx;
  font-weight: 600;
}

.muted {
  font-size: 24rpx;
  color: var(--s-2);
}

.note {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--s-2);
  line-height: 1.6;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.act {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
}

.remove {
  font-size: 24rpx;
  color: #b4392c;
}

.sheet-person {
  display: flex;
  align-items: center;
  padding: 22rpx;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 22rpx;
  background: rgba(242, 242, 247, 0.72);
}

.sheet-person__avatar {
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.sheet-person__meta {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.sheet-person__name {
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 700;
}

.sheet-person__sub {
  margin-top: 6rpx;
  color: var(--s-2);
  font-size: 23rpx;
}

.sheet-reason {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.9);
}

.sheet-reason__label {
  color: var(--s-2);
  font-size: 22rpx;
}

.sheet-reason__text {
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 27rpx;
  line-height: 1.65;
  word-break: break-word;
}

.sheet-warning {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(180, 57, 44, 0.08);
}

.sheet-warning__title {
  color: var(--red);
  font-size: 25rpx;
  font-weight: 700;
}

.sheet-warning__text {
  margin-top: 7rpx;
  color: var(--s-2);
  font-size: 23rpx;
  line-height: 1.6;
}
