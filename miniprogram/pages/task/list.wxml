<view class="page page--tab task-page {{tabPageEnter ? 'tab-page-enter' : ''}}">
  <view class="head">
    <view class="head__copy">
      <view class="head__eyebrow">拍摄与协作</view>
      <view class="head__title">任务</view>
    </view>
    <view class="head__create glass" wx:if="{{!guestLocked}}" bindtap="onCreate">
      <text class="head__plus">＋</text>
      <text>发布</text>
    </view>
  </view>

  <view class="guest-lock card" wx:if="{{guestLocked}}">
    <view class="guest-lock__title">访客模式</view>
    <view class="guest-lock__text">任务需要成员身份查看和报名，请注册或登录成员账号。</view>
  </view>

  <view class="filters glass-strong" wx:if="{{!guestLocked}}">
    <view class="seg">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="seg__item {{tab === item.key ? 'seg__item--on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTab"
      >{{item.label}}</view>
    </view>

    <scroll-view class="chips" scroll-x enable-flex>
      <view
        wx:for="{{statusList}}"
        wx:key="key"
        class="chip {{status === item.key ? 'chip--on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onStatus"
      >{{item.label}}</view>
    </scroll-view>
  </view>

  <view class="error card" wx:if="{{loadError}}">
    <view class="error__title">任务没有加载出来</view>
    <view class="error__text">检查网络后重试，当前筛选条件会保留。</view>
    <button class="btn btn--ghost error__btn" bindtap="onRetry">重新加载</button>
  </view>

  <view class="skeleton-group" wx:elif="{{loading && !list.length}}">
    <view class="skeleton card"></view>
    <view class="skeleton card"></view>
    <view class="skeleton card"></view>
  </view>

  <view class="empty card" wx:elif="{{!guestLocked && !loading && !list.length}}">
    <view class="empty__icon">○</view>
    <view class="empty__title">这里还没有任务</view>
    <view class="empty__text">换个筛选条件，或者发布一个新任务。</view>
  </view>

  <view
    class="card task"
    wx:for="{{list}}"
    wx:key="_id"
    data-id="{{item._id}}"
    bindtap="onOpen"
  >
    <view class="task__head">
      <text class="tag {{item.phaseClass}}">{{item.phaseLabel}}</text>
      <text class="task__quota">{{item.quotaText}}</text>
    </view>
    <view class="task__title">{{item.title}}</view>
    <view class="task__meta">{{item.rangeText}}</view>
    <view class="task__location" wx:if="{{item.locationName}}">{{item.locationName}}</view>
    <view class="task__bottom">
      <text class="tag tag--gold">二课 {{item.erkeHours}} 学时</text>
      <text class="task__deadline" wx:if="{{item.signupPhase === 'open'}}">报名中 ›</text>
      <text class="task__deadline" wx:else>报名已截止</text>
    </view>
  </view>
</view>
