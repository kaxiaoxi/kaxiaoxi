.task-page {
  padding-top: 18rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 8rpx 26rpx;
}

.head__eyebrow {
  color: var(--s-2);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.head__title {
  margin-top: 8rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -1rpx;
}

.head__create {
  min-width: 148rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: var(--blue);
  font-size: 26rpx;
  font-weight: 700;
}

.head__create:active {
  opacity: 0.68;
}

.head__plus {
  font-size: 32rpx;
  line-height: 1;
}

.filters {
  padding: 14rpx;
  border-radius: 28rpx;
}

.seg {
  display: flex;
  padding: 4rpx;
  border-radius: 18rpx;
  background: rgba(118, 118, 128, 0.11);
}

.seg__item {
  flex: 1;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  transition: background-color 140ms var(--ease-standard);
}

.seg__item--on {
  color: var(--ink);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  font-weight: 600;
}

.chips {
  white-space: nowrap;
  margin-top: 14rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 54rpx;
  padding: 0 22rpx;
  margin-right: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  border-radius: 27rpx;
  color: var(--ink-2);
  background: rgba(255, 255, 255, 0.42);
  font-size: 24rpx;
}

.chip--on {
  color: #fff;
  border-color: transparent;
  background: var(--blue);
  font-weight: 600;
}

.task {
  position: relative;
  margin-top: 18rpx;
  padding: 30rpx;
  overflow: hidden;
  transition:
    opacity 140ms var(--ease-standard),
    transform 140ms var(--ease-standard);
}

.task::before {
  position: absolute;
  left: 0;
  top: 28rpx;
  bottom: 28rpx;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: rgba(46, 95, 126, 0.34);
  content: '';
}

.task:active {
  opacity: 0.8;
  transform: scale(0.992);
}

.task__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task__quota {
  color: var(--s-2);
  font-size: 24rpx;
}

.task__title {
  margin-top: 18rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.task__meta {
  margin-top: 10rpx;
  color: var(--s-2);
  font-size: 26rpx;
}

.task__location {
  margin-top: 7rpx;
  color: var(--s-2);
  font-size: 24rpx;
}

.task__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--sep);
}

.task__deadline {
  color: var(--blue);
  font-size: 23rpx;
  font-weight: 600;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.tag--gray {
  color: var(--s-2);
  background: rgba(118, 118, 128, 0.12);
}

.tag--green {
  color: var(--green);
  background: rgba(44, 122, 75, 0.12);
}

.tag--gold {
  color: var(--gold);
  background: var(--gold-soft);
}

.error,
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20rpx;
  padding: 44rpx 32rpx;
  text-align: center;
}

.error {
  align-items: flex-start;
  text-align: left;
}

.error__title,
.empty__title {
  font-size: 28rpx;
  font-weight: 700;
}

.error__text,
.empty__text {
  margin-top: 8rpx;
  color: var(--s-2);
  font-size: 24rpx;
  line-height: 1.55;
}

.error__btn {
  width: 210rpx;
  height: 72rpx;
  margin: 22rpx 0 0;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.empty__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  color: var(--blue);
  background: var(--blue-soft);
  font-size: 36rpx;
  line-height: 64rpx;
}

.skeleton-group {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.skeleton {
  height: 220rpx;
  background: linear-gradient(
    100deg,
    rgba(255, 255, 255, 0.7) 25%,
    rgba(255, 255, 255, 0.96) 42%,
    rgba(255, 255, 255, 0.7) 60%
  );
  background-size: 240% 100%;
  animation: skeleton-shift 1.4s ease-in-out infinite;
}

@keyframes skeleton-shift {
  from {
    background-position: 100% 0;
  }

  to {
    background-position: -100% 0;
  }
}
