.hero {
  padding: 8rpx 8rpx 28rpx;
}

.hero__title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero__title--done {
  color: var(--s-3);
  text-decoration: line-through;
}

.hero__chips {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  align-items: center;
}

.prio {
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.prio--high {
  background: rgba(180, 57, 44, 0.1);
  color: #b4392c;
}

.prio--mid {
  background: rgba(217, 164, 65, 0.18);
  color: #9a6b12;
}

.prio--low {
  background: rgba(118, 118, 128, 0.12);
  color: var(--s-2);
}

.chip {
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  background: rgba(118, 118, 128, 0.12);
  color: var(--s-2);
}

.chip--done {
  background: rgba(44, 122, 75, 0.12);
  color: var(--green);
}

.card {
  margin-bottom: 24rpx;
}

.desc {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ink-2);
  white-space: pre-wrap;
}

.row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--sep);
}

.row:last-child {
  border-bottom: none;
}

.row__key {
  width: 170rpx;
  flex-shrink: 0;
  color: var(--s-2);
  font-size: 26rpx;
}

.row__value {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.5;
}

.row__value--link {
  color: var(--blue);
  font-weight: 600;
}

.sub {
  font-size: 24rpx;
  color: var(--s-2);
  margin-bottom: 16rpx;
}

.people {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.people__item {
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(46, 95, 126, 0.08);
  color: var(--blue);
  font-size: 24rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.actions .btn {
  flex: 1;
}

.btn--danger {
  background: #fff;
  color: var(--red);
  border: 1rpx solid rgba(180, 57, 44, 0.28);
}

.btn--danger::after {
  border: none;
}
