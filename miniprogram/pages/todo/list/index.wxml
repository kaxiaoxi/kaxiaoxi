<view class="page">
  <view class="head">
    <view class="head__title">待办</view>
    <view class="head__add" bindtap="onAdd">＋ 新建</view>
  </view>

  <view class="seg">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="seg__item {{tab === item.key ? 'seg__item--on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTab"
    >{{item.label}}</view>
  </view>

  <view class="empty" wx:if="{{!loading && !list.length}}">{{emptyText}}</view>

  <view class="list">
    <view
      class="todo"
      wx:for="{{list}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="onOpen"
    >
      <view
        class="check {{item.done ? 'check--on' : ''}}"
        wx:if="{{tab === 'mine' || tab === 'done'}}"
        data-id="{{item._id}}"
        data-done="{{item.done ? '0' : '1'}}"
        catchtap="onToggle"
      >{{item.done ? '✓' : ''}}</view>

      <view class="todo__main">
        <view class="todo__title {{item.done ? 'todo__title--done' : ''}}">{{item.title}}</view>
        <view class="todo__meta">
          <text class="prio {{item.priorityClass}}">{{item.priorityLabel}}</text>
          <text wx:if="{{item.ownerName}}">{{item.ownerName}} 主责</text>
          <text wx:if="{{item.deptLabel}}">{{item.deptLabel}}</text>
          <text wx:if="{{item.dueLabel}}">{{item.dueLabel}}</text>
        </view>
        <view class="todo__foot">
          <text class="chip" wx:if="{{item.audience !== 'self'}}">{{item.audienceLabel}}</text>
          <text class="chip chip--join" wx:if="{{item.joinText}}">{{item.joinText}}</text>
          <text class="chip chip--src" wx:if="{{item.source === 'task'}}">来自任务</text>
        </view>
      </view>
    </view>
  </view>
</view>
