.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 24rpx;
}

.head__title {
  font-size: 56rpx;
  font-weight: 700;
}

.head__add {
  color: var(--blue);
  font-size: 28rpx;
  font-weight: 600;
}

.seg {
  display: flex;
  background: rgba(118, 118, 128, 0.12);
  border-radius: 18rpx;
  padding: 4rpx;
  margin-bottom: 20rpx;
}

.seg__item {
  flex: 1;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--ink-2);
  border-radius: 14rpx;
}

.seg__item--on {
  background: #fff;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.empty {
  padding: 160rpx 0;
  text-align: center;
  color: var(--s-2);
  font-size: 26rpx;
}

.list {
  background: var(--card);
  border-radius: var(--radius);
  overflow: hidden;
}

.row {
  display: flex;
  align-items: flex-start;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid var(--sep);
}

.row:last-child {
  border-bottom: none;
}

.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--s-3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  flex-shrink: 0;
  margin-right: 20rpx;
  margin-top: 4rpx;
}

.check--on {
  background: var(--blue);
  border-color: var(--blue);
}

.row__main {
  flex: 1;
  min-width: 0;
}

.row__title {
  font-size: 30rpx;
  font-weight: 600;
}

.row__title--done {
  color: var(--s-3);
  text-decoration: line-through;
}

.row__meta {
  margin-top: 8rpx;
  display: flex;
  gap: 14rpx;
  font-size: 22rpx;
  color: var(--s-2);
  align-items: center;
}

.prio {
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.prio--high {
  background: rgba(180, 57, 44, 0.1);
  color: #b4392c;
}

.prio--mid {
  background: rgba(217, 164, 65, 0.18);
  color: #9a6b12;
}

.prio--low {
  background: rgba(118, 118, 128, 0.12);
  color: var(--s-2);
}
