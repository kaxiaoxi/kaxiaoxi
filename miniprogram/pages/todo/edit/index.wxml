<view class="page">
  <view class="card">
    <view class="field">
      <view class="field__label">标题</view>
      <input class="field__input" maxlength="50" data-field="title" value="{{form.title}}" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="field__label">说明</view>
      <textarea
        class="textarea"
        maxlength="500"
        data-field="description"
        value="{{form.description}}"
        bindinput="onInput"
        placeholder="要做什么、卡在哪一步"
      />
    </view>
  </view>

  <view class="card">
    <view class="field" wx:if="{{showOwner}}">
      <view class="field__label">主责人</view>
      <picker range="{{memberNames}}" value="{{ownerIndex}}" bindchange="onOwner">
        <view class="picker">{{ownerIndex >= 0 && members[ownerIndex] ? members[ownerIndex].name : '请选择'}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="field__label">可见范围</view>
      <view class="seg">
        <view
          wx:for="{{audiences}}"
          wx:key="key"
          class="seg__item {{audience === item.key ? 'seg__item--on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onAudience"
        >{{item.label}}</view>
      </view>
      <view class="hint">{{audienceDesc}}</view>
    </view>

    <view class="field field--row" wx:if="{{showDept}}">
      <view class="field__label">部门</view>
      <picker range="{{deptLabels}}" value="{{deptIndex}}" bindchange="onDept">
        <view class="picker">{{deptLabels[deptIndex]}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="field__label">重要性</view>
      <view class="seg">
        <view
          wx:for="{{priorities}}"
          wx:key="value"
          class="seg__item {{priority === item.value ? 'seg__item--on' : ''}}"
          data-value="{{item.value}}"
          bindtap="onPriority"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="field field--row">
      <view class="field__label">截止日期</view>
      <view class="field__inline">
        <picker mode="date" value="{{dueDate}}" bindchange="onDue">
          <view class="picker">{{dueDate || '不设置'}}</view>
        </picker>
        <text class="field__clear" wx:if="{{dueDate}}" bindtap="onClearDue">清除</text>
      </view>
    </view>
  </view>

  <view class="footer">
    <button class="btn btn--primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">保存</button>
    <button class="btn btn--danger" wx:if="{{id}}" bindtap="onDelete">删除</button>
  </view>
</view>
