.card {
  margin-bottom: 24rpx;
}

.field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--sep);
}

.field:last-child {
  border-bottom: none;
}

.field--row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field__label {
  font-size: 26rpx;
  color: var(--s-2);
  margin-bottom: 12rpx;
}

.field--row .field__label {
  margin-bottom: 0;
}

.field__input {
  font-size: 30rpx;
  line-height: 1.5;
  min-height: 48rpx;
}

.field__inline {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.field__clear {
  font-size: 24rpx;
  color: var(--blue);
}

.picker {
  font-size: 30rpx;
  color: var(--ink);
  padding: 6rpx 0;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 30rpx;
  line-height: 1.5;
}

.seg {
  display: flex;
  background: rgba(118, 118, 128, 0.12);
  border-radius: 16rpx;
  padding: 4rpx;
}

.seg__item {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--s-2);
  border-radius: 12rpx;
}

.seg__item--on {
  background: #fff;
  font-weight: 600;
  color: var(--ink);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--s-2);
}

.footer {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn--danger {
  background: #fff;
  color: var(--red);
  border: 1rpx solid rgba(180, 57, 44, 0.28);
}

.btn--danger::after {
  border: none;
}

.picker--placeholder {
  color: var(--s-3);
}
