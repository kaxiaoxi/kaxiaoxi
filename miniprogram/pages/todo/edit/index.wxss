.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 0 28rpx;
  margin-bottom: 24rpx;
}

.field {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--sep);
}

.field:last-child {
  border-bottom: none;
}

.field.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field__label {
  font-size: 26rpx;
  color: var(--s-2);
}

.field__input {
  margin-top: 8rpx;
  font-size: 30rpx;
  height: 52rpx;
  line-height: 52rpx;
}

.textarea {
  margin-top: 10rpx;
  width: 100%;
  height: 140rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.seg {
  display: flex;
  background: rgba(118, 118, 128, 0.12);
  border-radius: 14rpx;
  padding: 4rpx;
  margin-top: 12rpx;
}

.seg__item {
  flex: 1;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  border-radius: 12rpx;
  color: var(--ink-2);
}

.seg__item--on {
  background: #fff;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.picker {
  background: #f2f3f5;
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
}

.footer {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn--danger {
  background: rgba(180, 57, 44, 0.1);
  color: #b4392c;
}
