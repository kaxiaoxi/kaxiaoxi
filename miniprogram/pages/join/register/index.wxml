<view class="page">
  <view class="hero">
    <view class="hero__title">完善资料</view>
    <view class="hero__sub">提交后由主席审核，通过即可使用</view>
  </view>

  <view class="form">
    <view class="field">
      <view class="field__label">姓名</view>
      <input class="field__input" placeholder="真实姓名" maxlength="20" data-field="name" value="{{form.name}}" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="field__label">学号</view>
      <input class="field__input" placeholder="请填写完整学号" type="number" maxlength="20" data-field="studentNo" value="{{form.studentNo}}" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="field__label">学院</view>
      <input class="field__input" placeholder="请填写学院全称" maxlength="30" data-field="college" value="{{form.college}}" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="field__label">手机号</view>
      <input class="field__input" placeholder="11 位手机号" type="number" maxlength="11" data-field="phone" value="{{form.phone}}" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="field__label">宿舍号</view>
      <input class="field__input" placeholder="如 东一636" maxlength="15" data-field="dorm" value="{{form.dorm}}" bindinput="onInput" />
      <view class="field__tip">格式：东/西 + 楼号 + 房号</view>
    </view>

    <view class="field">
      <view class="field__label">生日（选填）</view>
      <picker mode="date" start="1995-01-01" end="2012-12-31" value="{{form.birthday}}" bindchange="onBirthdayChange">
        <view class="field__input {{form.birthday ? '' : 'field__input--placeholder'}}">
          {{form.birthday || '请选择生日'}}
        </view>
      </picker>
    </view>

    <view class="field">
      <view class="field__label">部门</view>
      <picker mode="selector" range="{{deptLabels}}" value="{{deptIndex}}" bindchange="onDeptChange">
        <view class="field__input {{form.dept ? '' : 'field__input--placeholder'}}">
          {{form.dept ? deptLabels[deptIndex] : '请选择部门'}}
        </view>
      </picker>
    </view>
  </view>

  <view class="footer">
    <button class="btn btn--primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">提交申请</button>
    <view class="footer__tip">学号唯一，注册后不可自行修改</view>
  </view>
</view>
