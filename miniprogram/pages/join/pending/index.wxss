.page--center {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.ip {
  width: 300rpx;
  height: 300rpx;
}

.title {
  margin-top: 40rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.desc {
  margin: 20rpx 0 60rpx;
  font-size: 28rpx;
  color: var(--s-2);
  text-align: center;
  line-height: 1.6;
  white-space: pre-line;
}

.btn--wide {
  width: 560rpx;
  margin-bottom: 24rpx;
}

.refresh-btn__content {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.refresh-btn__slot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
  margin-right: 14rpx;
}

.refresh-btn__text {
  line-height: 1;
  white-space: nowrap;
}

.refresh-btn__spinner {
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.45);
  border-top-color: #fff;
  border-radius: 50%;
  animation: refresh-spin 700ms linear infinite;
}

@keyframes refresh-spin {
  to {
    transform: rotate(360deg);
  }
}
