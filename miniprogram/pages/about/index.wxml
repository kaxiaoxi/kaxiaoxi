<view class="page">
  <view class="hero">
    <image class="hero__logo-img" src="/images/kaxiaoxi-mascot.png" mode="widthFix" />
    <view class="hero__name">影协工坊</view>
    <view class="hero__version">v{{version}} · 广工影协内部版</view>
    <view class="hero__desc">任务派发 · 报名候补 · 年历待办 · 二课统计</view>
  </view>

  <view class="section">条款与政策</view>
  <view class="card">
    <view class="row" data-type="terms" bindtap="onOpenDoc">
      <text>用户协议</text>
      <text class="row__arrow">›</text>
    </view>
    <view class="row" data-type="privacy" bindtap="onOpenDoc">
      <text>隐私政策</text>
      <text class="row__arrow">›</text>
    </view>
  </view>

  <view class="section">意见反馈</view>
  <view class="card">
    <textarea
      class="textarea"
      maxlength="500"
      placeholder="说说你遇到的问题或建议，会直接发给主席团"
      value="{{content}}"
      bindinput="onContent"
    />
    <input
      class="contact"
      maxlength="50"
      placeholder="联系方式（选填，方便回复你）"
      value="{{contact}}"
      bindinput="onContact"
    />
    <button class="btn btn--primary submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">
      提交反馈
    </button>
  </view>

  <view class="section">开发鸣谢</view>
  <view class="card thanks">
    <view class="thanks__item">
      <text class="thanks__role">开发</text>
      <text class="thanks__name">待补充</text>
    </view>
    <view class="thanks__item">
      <text class="thanks__role">设计</text>
      <text class="thanks__name">待补充</text>
    </view>
    <view class="thanks__item">
      <text class="thanks__role">内测</text>
      <text class="thanks__name">待补充</text>
    </view>
    <view class="thanks__item">
      <text class="thanks__role">形象与版权</text>
      <text class="thanks__name">待补充</text>
    </view>
  </view>

  <view class="footer">© 2026 广东工业大学摄影协会</view>
</view>

