.hero {
  padding: 48rpx 8rpx 40rpx;
  text-align: center;
}

.hero__logo-img {
  width: 200rpx;
  height: auto;
  display: block;
  margin: 0 auto 12rpx;
}

.hero__name {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--s-2);
}

.hero__version {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--s-3);
}

.hero__desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--s-3);
}

.section {
  margin: 24rpx 8rpx 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--s-2);
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 8rpx 28rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--sep);
  font-size: 30rpx;
}

.row:last-child {
  border-bottom: none;
}

.row__arrow {
  color: var(--s-3);
}

.textarea {
  width: 100%;
  height: 200rpx;
  margin: 24rpx 0 8rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.contact {
  width: 100%;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--sep);
  font-size: 26rpx;
}

.submit {
  margin: 16rpx 0 24rpx;
}

.owner {
  margin-top: 24rpx;
  padding: 28rpx;
}

.owner__title {
  font-size: 28rpx;
  font-weight: 600;
}

.owner__desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--s-2);
}

.owner__btn {
  margin-top: 24rpx;
}

.thanks {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.thanks__item {
  display: flex;
  padding: 14rpx 0;
  font-size: 26rpx;
}

.thanks__role {
  width: 100rpx;
  color: var(--s-3);
}

.thanks__name {
  flex: 1;
  color: var(--ink);
}

.footer {
  margin: 48rpx 0 64rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--s-3);
}
