.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 0 28rpx;
  margin-bottom: 24rpx;
}

.field {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--sep);
}

.field:last-child {
  border-bottom: none;
}

.field.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field__label {
  font-size: 26rpx;
  color: var(--s-2);
}

.field__input {
  margin-top: 8rpx;
  font-size: 30rpx;
  height: 52rpx;
  line-height: 52rpx;
}

.times {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.picker {
  background: #f2f3f5;
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
}

.sep {
  color: var(--s-3);
}

.textarea {
  margin-top: 10rpx;
  width: 100%;
  height: 140rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.footer {
  margin-top: 16rpx;
}
