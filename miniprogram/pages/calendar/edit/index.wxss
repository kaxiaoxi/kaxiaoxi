.card {
  margin-bottom: 24rpx;
}

.field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--sep);
}

.field:last-child {
  border-bottom: none;
}

.field--row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field__label {
  font-size: 26rpx;
  color: var(--s-2);
  margin-bottom: 12rpx;
}

.field--row .field__label {
  margin-bottom: 0;
}

.field__input {
  font-size: 30rpx;
  line-height: 1.5;
  min-height: 48rpx;
}

.field__inline {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.field__clear {
  font-size: 24rpx;
  color: var(--blue);
}

.picker {
  font-size: 30rpx;
  color: var(--ink);
  padding: 6rpx 0;
  text-align: right;
}

.quick {
  margin-top: 12rpx;
  display: flex;
  gap: 12rpx;
}

.quick__item {
  padding: 4rpx 18rpx;
  border-radius: 10rpx;
  background: rgba(118, 118, 128, 0.12);
  color: var(--s-2);
  font-size: 24rpx;
}

.seg {
  display: flex;
  background: rgba(118, 118, 128, 0.12);
  border-radius: 16rpx;
  padding: 4rpx;
}

.seg__item {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--s-2);
  border-radius: 12rpx;
}

.seg__item--on {
  background: #fff;
  font-weight: 600;
  color: var(--ink);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 30rpx;
  line-height: 1.5;
}

.footer {
  margin-top: 8rpx;
}

.picker--placeholder {
  color: var(--s-3);
}

.name-trigger__arrow {
  margin-left: 12rpx;
  color: var(--s-3);
  font-size: 32rpx;
}

.field__value {
  font-size: 28rpx;
  color: var(--ink);
}

.field__value--placeholder {
  color: var(--s-3);
}

.name-options {
  display: flex;
  flex-direction: column;
}

.name-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid var(--sep);
  font-size: 29rpx;
  color: var(--ink);
}

.name-option:last-child {
  border-bottom: none;
}

.name-option--on {
  color: var(--blue);
  font-weight: 600;
}

.name-option__check {
  color: var(--blue);
  font-size: 28rpx;
  font-weight: 700;
}
