<view class="page">
  <view class="card">
    <view class="field">
      <view class="field__label">名称</view>
      <input
        class="field__input"
        maxlength="30"
        data-field="title"
        value="{{form.title}}"
        bindinput="onInput"
        placeholder="如：大学城秋日人像外拍"
      />
    </view>

    <view class="field field--row">
      <view class="field__label">类型</view>
      <picker range="{{types}}" value="{{typeIndex}}" bindchange="onType">
        <view class="picker">{{types[typeIndex]}}</view>
      </picker>
    </view>

    <view class="field field--row">
      <view class="field__label">开始日期</view>
      <picker mode="date" value="{{startDate}}" bindchange="onStartDate">
        <view class="picker">{{startDate}}</view>
      </picker>
    </view>

    <view class="field field--row">
      <view class="field__label">结束日期</view>
      <view class="field__inline">
        <picker mode="date" value="{{endDate || startDate}}" bindchange="onEndDate">
          <view class="picker">{{endDate || '单日'}}</view>
        </picker>
        <text class="field__clear" wx:if="{{endDate}}" bindtap="onClearEndDate">清除</text>
      </view>
    </view>

    <view class="field">
      <view class="field__label">时间</view>
      <input
        class="field__input"
        maxlength="20"
        data-field="timeText"
        value="{{form.timeText}}"
        bindinput="onInput"
        placeholder="14:00-17:00 / 待定"
      />
      <view class="quick">
        <text class="quick__item" data-text="全天" bindtap="onQuickTime">全天</text>
        <text class="quick__item" data-text="待定" bindtap="onQuickTime">待定</text>
      </view>
    </view>

    <view class="field">
      <view class="field__label">地点</view>
      <input
        class="field__input"
        maxlength="40"
        data-field="location"
        value="{{form.location}}"
        bindinput="onInput"
        placeholder="大学城中心湖"
      />
    </view>
  </view>

  <view class="card">
    <view class="field field--row" bindtap="onOpenOwnerPicker">
      <view class="field__label">主负责人</view>
      <view class="picker {{ownerName ? '' : 'picker--placeholder'}}">{{ownerName || '请选择'}}</view>
    </view>

    <view class="field field--row" bindtap="onOpenDeputyPicker">
      <view class="field__label">副负责人</view>
      <view class="picker {{deputyName ? '' : 'picker--placeholder'}}">{{deputyName || '不设置'}}</view>
    </view>

    <view class="field field--row">
      <view class="field__label">状态</view>
      <picker range="{{statuses}}" value="{{statusIndex}}" bindchange="onStatus">
        <view class="picker">{{statuses[statusIndex]}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="field__label">可见范围</view>
      <view class="seg">
        <view
          class="seg__item {{visibility === 'public' ? 'seg__item--on' : ''}}"
          data-value="public"
          bindtap="onVisibility"
        >全体可见</view>
        <view
          class="seg__item {{visibility === 'staff' ? 'seg__item--on' : ''}}"
          data-value="staff"
          bindtap="onVisibility"
        >仅部长主席</view>
      </view>
    </view>

    <view class="field field--row">
      <view class="field__label">提醒日</view>
      <view class="field__inline">
        <picker mode="date" value="{{remindDate || startDate}}" bindchange="onRemindDate">
          <view class="picker">{{remindDate || '不提醒'}}</view>
        </picker>
        <text class="field__clear" wx:if="{{remindDate}}" bindtap="onClearRemindDate">清除</text>
      </view>
    </view>

    <view class="field">
      <view class="field__label">备注</view>
      <textarea
        class="textarea"
        maxlength="500"
        data-field="note"
        value="{{form.note}}"
        bindinput="onInput"
        placeholder="集合方式、报名链接等"
      />
    </view>
  </view>

  <view class="footer">
    <button class="btn btn--primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">保存</button>
  </view>

  <member-picker
    id="memberPicker"
    visible="{{pickerVisible}}"
    title="{{pickerTitle}}"
    members="{{members}}"
    value="{{pickerValue}}"
    exclude="{{pickerExclude}}"
    allow-empty="{{pickerTarget === 'deputy'}}"
    empty-text="不设置"
    bind:select="onPickerSelect"
    bind:close="onPickerClose"
  />
</view>
