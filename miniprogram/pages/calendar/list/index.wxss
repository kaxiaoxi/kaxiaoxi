.page {
  background: var(--bg);
  min-height: 100vh;
  padding: 24rpx 0 160rpx;
  box-sizing: border-box;
}

.filters {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx 20rpx;
}

.seg {
  flex: 1;
  display: flex;
  background: rgba(118, 118, 128, 0.12);
  border-radius: 16rpx;
  padding: 4rpx;
}

.seg__item {
  flex: 1;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--s-2);
  border-radius: 12rpx;
}

.seg__item--on {
  background: #fff;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.table-scroll {
  background: #fff;
  white-space: nowrap;
}

.table {
  display: flex;
  flex-direction: column;
  width: 1340rpx;
}

.tr {
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid var(--sep);
}

.tr--head {
  background: #f7f7f8;
  color: var(--s-2);
  font-size: 22rpx;
  font-weight: 600;
}

.td {
  padding: 20rpx 16rpx;
  font-size: 24rpx;
  flex-shrink: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 首列固定：横向滚动时日期始终在左边 */
.td--sticky {
  position: sticky;
  left: 0;
  z-index: 2;
  background: #fff;
  box-shadow: 2rpx 0 0 var(--sep);
}

.tr--head .td--sticky {
  background: #f7f7f8;
}

.td--date {
  width: 160rpx;
  color: var(--s-2);
}

.td--title {
  width: 320rpx;
  font-weight: 600;
  color: var(--ink);
}

.td--type {
  width: 280rpx;
}

.td--loc {
  width: 200rpx;
  color: var(--s-2);
}

.td--owner {
  width: 140rpx;
  color: var(--s-2);
}

.td--status {
  width: 140rpx;
}

.td--vis {
  width: 100rpx;
  color: var(--s-2);
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  background: #8e8e93;
}

.dot--shoot {
  background: #ff9500;
}

.dot--lecture {
  background: #5ac8fa;
}

.dot--contest {
  background: #ff3b30;
}

.dot--meeting {
  background: #34c759;
}

.dot--gear {
  background: #8e8e93;
}

.dot--article {
  background: #ffcc00;
}

.dot--party {
  background: #af52de;
}

.dot--recruit {
  background: #007aff;
}

.dot--deadline {
  background: #ff2d55;
}

.dot--other {
  background: #8e8e93;
}

.td__text {
  overflow: hidden;
  text-overflow: ellipsis;
}

.chip {
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  background: rgba(142, 142, 147, 0.14);
  color: #6c6c70;
}

.chip--gray {
  background: rgba(142, 142, 147, 0.14);
  color: #6c6c70;
}

.chip--blue {
  background: rgba(0, 122, 255, 0.12);
  color: #007aff;
}

.chip--green {
  background: rgba(52, 199, 89, 0.16);
  color: #248a3d;
}

.chip--red {
  background: rgba(255, 59, 48, 0.14);
  color: #d70015;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: var(--s-2);
  font-size: 26rpx;
}

.loading {
  padding: 40rpx 0;
  text-align: center;
  color: var(--s-2);
  font-size: 24rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  height: 88rpx;
  padding: 0 42rpx;
  border-radius: 44rpx;
  background: var(--blue);
  color: #fff;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(46, 95, 126, 0.32);
}
