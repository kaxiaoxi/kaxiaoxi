.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 20rpx;
}

.head__title {
  font-size: 56rpx;
  font-weight: 700;
}

.head__actions {
  display: flex;
  gap: 28rpx;
  font-size: 26rpx;
  color: var(--blue);
  font-weight: 600;
}

.month {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
}

.month__text {
  font-size: 32rpx;
  font-weight: 600;
}

.month__arrow {
  font-size: 40rpx;
  color: var(--s-3);
  padding: 0 16rpx;
}

.week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  font-size: 22rpx;
  color: var(--s-3);
  margin: 16rpx 0 6rpx;
}

.grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 2rpx;
}

.cell {
  height: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 2rpx 0;
  border-radius: 12rpx;
  overflow: hidden;
}

.cell--mute .cell__day {
  color: var(--s-3);
}

.cell--today .cell__day {
  color: var(--blue);
  font-weight: 700;
}

.cell--on {
  background: var(--blue);
}

.cell--on .cell__day {
  color: #fff;
  font-weight: 600;
}

.cell__day {
  font-size: 24rpx;
  line-height: 1.2;
  color: var(--ink-2);
}

.cell__events {
  width: 100%;
  margin-top: 2rpx;
  overflow: hidden;
}

.cell__event {
  font-size: 16rpx;
  line-height: 1.35;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding: 0 2rpx;
}

.cell__more {
  font-size: 15rpx;
  line-height: 1.2;
  text-align: center;
  color: var(--s-3);
}

.cell--on .cell__event,
.cell--on .cell__more {
  color: rgba(255, 255, 255, 0.92);
}

.ev--recruit {
  color: #2e5f7e;
}

.ev--meeting {
  color: #4f7a4f;
}

.ev--shoot {
  color: #a9762f;
}

.ev--contest {
  color: #a34a3a;
}

.ev--exhibit {
  color: #6b5b95;
}

.ev--deadline {
  color: #b4392c;
}

.ev--other {
  color: #8a8a8e;
}

.loading {
  text-align: center;
  font-size: 22rpx;
  color: var(--s-3);
  padding: 12rpx 0;
}

.section {
  margin: 28rpx 8rpx 16rpx;
  font-size: 28rpx;
  color: var(--s-2);
  font-weight: 600;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  color: var(--s-2);
  font-size: 26rpx;
}

.event {
  margin-bottom: 20rpx;
}

.event__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.tag--recruit {
  background: rgba(46, 95, 126, 0.12);
  color: #2e5f7e;
}

.tag--meeting {
  background: rgba(79, 122, 79, 0.14);
  color: #4f7a4f;
}

.tag--shoot {
  background: rgba(169, 118, 47, 0.14);
  color: #a9762f;
}

.tag--contest {
  background: rgba(163, 74, 58, 0.14);
  color: #a34a3a;
}

.tag--exhibit {
  background: rgba(107, 91, 149, 0.14);
  color: #6b5b95;
}

.tag--deadline {
  background: rgba(180, 57, 44, 0.12);
  color: #b4392c;
}

.tag--other {
  background: rgba(118, 118, 128, 0.12);
  color: var(--s-2);
}

.event__time {
  font-size: 24rpx;
  color: var(--s-2);
}

.event__title {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.event__meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--s-2);
}
