.calendar-page {
  padding-top: 18rpx;
}

.calendar-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 8rpx 22rpx;
}

.topbar__year {
  display: flex;
  align-items: center;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 700;
}

.topbar__chev {
  margin-right: 8rpx;
  color: var(--blue);
  font-size: 40rpx;
}

.calendar-top__actions {
  display: flex;
  gap: 12rpx;
}

.calendar-top__btn,
.calendar-top__add {
  height: 68rpx;
  min-width: 112rpx;
  padding: 0 22rpx;
  border-radius: 23rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--blue);
  font-size: 24rpx;
  font-weight: 600;
}

.calendar-top__add {
  min-width: 68rpx;
  width: 68rpx;
  padding: 0;
  font-size: 36rpx;
}

.calendar-top__btn:active,
.calendar-top__add:active {
  opacity: 0.68;
}

.calendar-panel {
  padding: 20rpx 14rpx 18rpx;
}

.month-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 2rpx;
}

.month-arrow {
  width: 72rpx;
  padding: 12rpx 0;
  color: var(--blue);
  font-size: 42rpx;
  line-height: 1;
  text-align: center;
}

.month-title {
  min-width: 210rpx;
  padding: 4rpx 0 14rpx;
  color: var(--ink);
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-align: center;
}

.week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding: 6rpx 0 10rpx;
  color: var(--s-2);
  font-size: 21rpx;
  text-align: center;
}

.grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  overflow: hidden;
  border-radius: 18rpx;
  background: rgba(242, 242, 247, 0.7);
}

.cell {
  min-width: 0;
  min-height: 124rpx;
  padding: 6rpx 4rpx 8rpx;
  border-right: 1rpx solid rgba(60, 60, 67, 0.07);
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.07);
  overflow: hidden;
}

.cell:nth-child(7n) {
  border-right: none;
}

.cell--mute .daynum {
  color: rgba(60, 60, 67, 0.32);
}

.cell--mute .pill {
  opacity: 0.4;
}

.daynum-wrap {
  height: 42rpx;
  display: flex;
  justify-content: center;
}

.daynum {
  min-width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 42rpx;
  text-align: center;
}

.cell--selected .daynum {
  color: #fff;
  background: var(--blue);
  font-weight: 600;
}

.pills {
  margin-top: 2rpx;
}

.pill {
  margin-top: 3rpx;
  padding: 0 5rpx;
  border-radius: 5rpx;
  font-size: 16rpx;
  font-weight: 500;
  line-height: 26rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pill--recruit {
  color: var(--blue);
  background: var(--blue-soft);
}

.pill--meeting {
  color: var(--green);
  background: rgba(44, 122, 75, 0.11);
}

.pill--shoot {
  color: var(--gold);
  background: var(--gold-soft);
}

.pill--contest,
.pill--deadline {
  color: var(--red);
  background: rgba(180, 57, 44, 0.11);
}

.pill--exhibit {
  color: #6f4a84;
  background: rgba(127, 78, 151, 0.12);
}

.pill--other {
  color: var(--s-2);
  background: rgba(118, 118, 128, 0.12);
}

.pill-more {
  padding-left: 5rpx;
  color: var(--s-2);
  font-size: 15rpx;
  line-height: 24rpx;
}

.loading {
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  color: var(--s-2);
  font-size: 23rpx;
  text-align: center;
}

.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 8rpx 14rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.day-head__count {
  color: var(--s-2);
  font-size: 22rpx;
  font-weight: 500;
}

.event-group {
  padding-top: 0;
  padding-bottom: 0;
}

.event {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid var(--sep);
}

.event:last-child {
  border-bottom: none;
}

.event:active {
  opacity: 0.72;
}

.event__bar {
  width: 6rpx;
  height: 60rpx;
  flex: 0 0 6rpx;
  margin-right: 18rpx;
  border-radius: 4rpx;
}

.bar--recruit {
  background: var(--blue);
}

.bar--meeting {
  background: var(--green);
}

.bar--shoot {
  background: #a57924;
}

.bar--contest,
.bar--deadline {
  background: var(--red);
}

.bar--exhibit {
  background: #7f4e97;
}

.bar--other {
  background: #77777c;
}

.event__main {
  flex: 1;
  min-width: 0;
}

.event__title {
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 600;
}

.event__meta {
  margin-top: 7rpx;
  color: var(--s-2);
  font-size: 23rpx;
}

.event__arrow {
  margin-left: 12rpx;
  color: var(--s-3);
  font-size: 34rpx;
}

.empty,
.error {
  display: flex;
  flex-direction: column;
  margin-top: 18rpx;
  padding: 38rpx 30rpx;
}

.error {
  align-items: flex-start;
}

.empty {
  align-items: center;
  text-align: center;
}

.error__title,
.empty__title {
  font-size: 27rpx;
  font-weight: 700;
}

.error__text,
.empty__text {
  margin-top: 8rpx;
  color: var(--s-2);
  font-size: 23rpx;
  line-height: 1.5;
}

.error__btn {
  width: 210rpx;
  height: 72rpx;
  margin: 20rpx 0 0;
  border-radius: 20rpx;
  font-size: 25rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(156rpx + env(safe-area-inset-bottom));
  z-index: 80;
  height: 76rpx;
  padding: 0 32rpx;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  color: var(--blue);
  font-size: 25rpx;
  font-weight: 700;
}

.fab:active {
  opacity: 0.68;
}
