.hero {
  padding: 8rpx 8rpx 28rpx;
}

.hero__title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero__chips {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.chip {
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  background: rgba(142, 142, 147, 0.14);
  color: #6c6c70;
}

.chip--type {
  background: rgba(46, 95, 126, 0.1);
  color: var(--blue);
  font-weight: 600;
}

.chip--gray {
  background: rgba(142, 142, 147, 0.14);
  color: #6c6c70;
}

.chip--blue {
  background: rgba(0, 122, 255, 0.12);
  color: #007aff;
}

.chip--green {
  background: rgba(52, 199, 89, 0.16);
  color: #248a3d;
}

.chip--red {
  background: rgba(255, 59, 48, 0.14);
  color: #d70015;
}

.card {
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--sep);
}

.row:last-child {
  border-bottom: none;
}

.row__key {
  width: 150rpx;
  flex-shrink: 0;
  color: var(--s-2);
  font-size: 26rpx;
}

.row__value {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.section {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--s-2);
  padding: 8rpx 8rpx 16rpx;
}

.link {
  display: flex;
  align-items: center;
}

.link__main {
  flex: 1;
  min-width: 0;
}

.link__title {
  font-size: 28rpx;
  font-weight: 600;
}

.link__arrow {
  font-size: 40rpx;
  color: var(--s-3);
}

.todo {
  padding: 20rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--sep);
}

.todo:last-child {
  border-bottom: none;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.actions .btn {
  flex: 1;
}

.btn--danger {
  background: #fff;
  color: var(--red);
  border: 1rpx solid rgba(180, 57, 44, 0.28);
}

.btn--danger::after {
  border: none;
}
