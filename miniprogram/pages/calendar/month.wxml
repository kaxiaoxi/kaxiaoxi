<view class="page">
  <view class="topbar">
    <view class="topbar__year" bindtap="onToday">
      <text class="topbar__chev">‹</text>
      <text>{{year}}年</text>
    </view>
    <view class="topbar__actions">
      <text class="topbar__btn" bindtap="onCreate">＋</text>
    </view>
  </view>

  <view class="month-row">
    <text class="month-arrow" bindtap="onPrev">‹</text>
    <picker
      mode="date"
      fields="month"
      value="{{pickerValue}}"
      start="2020-01"
      end="2035-12"
      bindchange="onPickMonth"
    >
      <view class="month-title">{{monthName}}</view>
    </picker>
    <text class="month-arrow" bindtap="onNext">›</text>
  </view>

  <view class="week">
    <text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
  </view>

  <view class="grid" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
    <view
      wx:for="{{cells}}"
      wx:key="key"
      class="cell {{item.inMonth ? '' : 'cell--mute'}} {{item.key === selected ? 'cell--selected' : ''}}"
      data-key="{{item.key}}"
      bindtap="onSelect"
    >
      <view class="daynum-wrap">
        <text class="daynum">{{item.day}}</text>
      </view>
      <view class="pills">
        <view
          wx:for="{{item.items}}"
          wx:for-item="ev"
          wx:key="id"
          class="pill pill--{{ev.colorKey}}"
        >{{ev.title}}</view>
        <view class="pill-more" wx:if="{{item.more}}">+{{item.more}}</view>
      </view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <view class="day-head">{{selectedLabel}}</view>
  <view class="empty" wx:if="{{!dayEvents.length}}">当天没有安排</view>
  <view class="event" wx:for="{{dayEvents}}" wx:key="_id" data-id="{{item._id}}" bindtap="onOpen">
    <view class="event__bar bar--{{item.colorKey}}"></view>
    <view class="event__main">
      <view class="event__title">{{item.title}}</view>
      <view class="event__meta">
        <text>{{item.timeText}}</text>
        <text wx:if="{{item.locationName}}"> · {{item.locationName}}</text>
      </view>
    </view>
  </view>

  <view class="fab" bindtap="onToday">今天</view>
</view>

