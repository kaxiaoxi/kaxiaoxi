<view class="page">
  <view class="greet">
    <view class="greet__title">你好，{{member.name || '同学'}}</view>
    <view class="greet__sub">{{deptLabel}}<text wx:if="{{roleLabel}}"> · {{roleLabel}}</text></view>
  </view>

  <view class="section">
    未读消息
    <text class="section__count" wx:if="{{unreadMessages.length}}">{{unreadMessages.length}}</text>
  </view>
  <view class="card msg" wx:if="{{!unreadMessages.length}}">
    <view class="muted">没有未读消息</view>
  </view>
  <view
    class="card msg"
    wx:for="{{unreadMessages}}"
    wx:key="_id"
    data-id="{{item._id}}"
    bindtap="onOpenMessage"
  >
    <view class="msg__head">
      <text class="msg__title">{{item.title}}</text>
      <text class="msg__time">{{item.timeText}}</text>
    </view>
    <view class="msg__content">{{item.content}}</view>
  </view>

  <view class="section">近期任务</view>
  <view class="card" wx:if="{{!tasks.length}}">
    <view class="muted">还没有任务，等部长发布后这里会出现</view>
  </view>
  <view class="card task" wx:for="{{tasks}}" wx:key="_id">
    <view class="task__title">{{item.title}}</view>
    <view class="muted">{{item.dateText}}</view>
  </view>

  <view class="section">我的待办</view>
  <view class="card" wx:if="{{!todos.length}}">
    <view class="muted">暂时没有待办</view>
  </view>
  <view class="card task" wx:for="{{todos}}" wx:key="_id">
    <view class="task__title">{{item.title}}</view>
    <view class="muted">{{item.dueText}}</view>
  </view>
</view>

<view class="modal" wx:if="{{showMessage}}">
  <view class="modal__mask" bindtap="onCloseMessage"></view>
  <view class="modal__card">
    <view class="modal__title">{{activeMessage.title}}</view>
    <view class="modal__time">{{activeMessage.timeText}}</view>
    <scroll-view class="modal__body" scroll-y>
      <text class="modal__text">{{activeMessage.content}}</text>
    </scroll-view>
    <button class="btn btn--primary modal__btn" bindtap="onCloseMessage">知道了</button>
  </view>
</view>
