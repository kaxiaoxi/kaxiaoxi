.launch {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #f8fbfc 0%, #e7eff5 100%);
}

.launch__logo {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.launch__tip {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--s-2);
}
