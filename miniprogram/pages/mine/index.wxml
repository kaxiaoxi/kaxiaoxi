<view class="page">
  <view class="profile">
    <view class="profile__avatar-wrap">
      <image
        wx:if="{{member.avatarFileID}}"
        class="profile__avatar-img"
        src="{{member.avatarFileID}}"
        mode="aspectFill"
      />
      <view wx:else class="profile__avatar" style="background: {{member.avatarColor || '#2E5F7E'}}">
        {{member.avatarText || '?'}}
      </view>
      <button
        class="profile__avatar-btn"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
        hover-class="none"
      ></button>
      <view class="profile__avatar-tip">换头像</view>
    </view>
    <view class="profile__meta">
      <view class="profile__name">{{member.name || '未登录'}}</view>
      <view class="profile__sub">{{deptLabel}} · {{roleLabel}} · {{member.academicYear || ''}}</view>
    </view>
  </view>

  <view class="list">
    <view class="row">
      <text class="row__key">学号</text>
      <text class="row__value">{{member.studentNo || '-'}}</text>
    </view>
    <view class="row">
      <text class="row__key">学院</text>
      <text class="row__value">{{member.college || '-'}}</text>
    </view>
    <view class="row">
      <text class="row__key">手机号</text>
      <text class="row__value">{{member.phone || '-'}}</text>
    </view>
    <view class="row">
      <text class="row__key">生日</text>
      <text class="row__value">{{member.birthday || '-'}}</text>
    </view>
    <view class="row">
      <text class="row__key">宿舍</text>
      <text class="row__value">{{member.dorm || '-'}}</text>
    </view>
    <view class="row">
      <text class="row__key">状态</text>
      <text class="row__value">{{statusLabel || '-'}}</text>
    </view>
  </view>

  <view class="entry" bindtap="onOpenTodos">
    <text>我的待办</text>
    <text class="entry__arrow">›</text>
  </view>

  <view class="entry" bindtap="onOpenErke">
    <text>我的二课</text>
    <text class="entry__arrow">›</text>
  </view>

  <view class="entry" bindtap="onOpenMessages">
    <text>消息</text>
    <text class="entry__arrow">›</text>
  </view>

  <view class="entry" bindtap="onEditProfile">
    <text>编辑资料</text>
    <text class="entry__arrow">›</text>
  </view>

  <view class="entry" wx:if="{{isMinister}}" bindtap="onOpenSummary">
    <text>二课汇总</text>
    <text class="entry__arrow">›</text>
  </view>

  <view class="entry" wx:if="{{isChairman}}" bindtap="onOpenSettings">
    <text>设置</text>
    <text class="entry__arrow">›</text>
  </view>

  <view class="entry" wx:if="{{isChairman}}" bindtap="onOpenMembers">
    <text>成员管理</text>
    <text class="entry__arrow">›</text>
  </view>
</view>

