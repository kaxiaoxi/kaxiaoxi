.mine-page {
  padding-top: 22rpx;
}

.profile {
  position: relative;
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  border-radius: 32rpx;
}

.profile__avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex: 0 0 120rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 42rpx;
  box-shadow: 0 8rpx 24rpx rgba(35, 63, 80, 0.12);
}

.profile__avatar {
  width: 100%;
  height: 100%;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 46rpx;
  font-weight: 600;
}

.profile__avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 38rpx;
  display: block;
  background: #ffffff;
}

.profile__avatar-btn {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  box-sizing: border-box;
  opacity: 0;
}

.profile__avatar-btn::after {
  border: none;
}

.profile__meta {
  flex: 1;
  min-width: 0;
  margin-left: 26rpx;
}

.profile__name {
  overflow: hidden;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile__sub {
  margin-top: 6rpx;
  color: var(--s-2);
  font-size: 24rpx;
}

.profile__year {
  margin-top: 7rpx;
  color: var(--s-2);
  font-size: 21rpx;
}

.profile__status {
  align-self: flex-start;
  margin-left: 12rpx;
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
  color: var(--green);
  background: rgba(44, 122, 75, 0.11);
  font-size: 20rpx;
  font-weight: 600;
}

.section-label {
  margin: 34rpx 10rpx 12rpx;
  color: var(--s-2);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.list {
  padding-top: 0;
  padding-bottom: 0;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 25rpx 0;
  border-bottom: 1rpx solid var(--sep);
  font-size: 28rpx;
}

.row:last-child {
  border-bottom: none;
}

.row__key {
  flex-shrink: 0;
  color: var(--s-2);
}

.row__value {
  min-width: 0;
  color: var(--ink);
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu {
  padding-top: 0;
  padding-bottom: 0;
  overflow: hidden;
}

.entry {
  display: flex;
  align-items: center;
  min-height: 102rpx;
  border-bottom: 1rpx solid var(--sep);
  transition: background-color 120ms var(--ease-standard);
}

.entry:last-child {
  border-bottom: none;
}

.entry--pressed {
  background: rgba(46, 95, 126, 0.05);
}

.entry__icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  border-radius: 14rpx;
  background: var(--blue-soft);
}

.entry__icon::before,
.entry__icon::after {
  position: absolute;
  content: '';
}

.entry__icon::before {
  left: 12rpx;
  top: 11rpx;
  width: 18rpx;
  height: 14rpx;
  border: 2rpx solid var(--blue);
  border-radius: 4rpx;
}

.entry__icon::after {
  left: 16rpx;
  top: 28rpx;
  width: 10rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: var(--blue);
}

.entry__icon--erke::before {
  left: 13rpx;
  top: 13rpx;
  width: 14rpx;
  height: 16rpx;
  border-radius: 3rpx;
}

.entry__icon--message::before {
  left: 10rpx;
  top: 12rpx;
  width: 18rpx;
  height: 14rpx;
  border-radius: 6rpx;
}

.entry__icon--profile::before {
  left: 16rpx;
  top: 9rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}

.entry__icon--profile::after {
  left: 11rpx;
  top: 22rpx;
  width: 18rpx;
  height: 9rpx;
  border: 2rpx solid var(--blue);
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  background: transparent;
}

.entry__icon--members::before,
.entry__icon--settings::before,
.entry__icon--about::before {
  left: 11rpx;
  top: 11rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.entry__text {
  flex: 1;
  margin-left: 18rpx;
  color: var(--ink);
  font-size: 28rpx;
}

.entry__arrow {
  color: var(--s-3);
  font-size: 34rpx;
}

.error {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-top: 18rpx;
}

.error__title {
  font-size: 27rpx;
  font-weight: 700;
}

.error__text {
  margin-top: 7rpx;
  color: var(--s-2);
  font-size: 23rpx;
  line-height: 1.5;
}

.error__btn {
  width: 210rpx;
  height: 72rpx;
  margin: 20rpx 0 0;
  border-radius: 20rpx;
  font-size: 25rpx;
}

.mine-footer {
  padding: 46rpx 0 20rpx;
  color: var(--s-2);
  font-size: 21rpx;
  text-align: center;
}
