.profile {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx 40rpx;
}

.profile__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  color: #fff;
  font-size: 48rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile__meta {
  margin-left: 28rpx;
}

.profile__name {
  font-size: 40rpx;
  font-weight: 700;
}

.profile__sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--s-2);
}

.list {
  background: var(--card);
  border-radius: var(--radius);
  padding: 0 28rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--sep);
  font-size: 30rpx;
}

.row:last-child {
  border-bottom: none;
}

.row__key {
  color: var(--s-2);
}

.row__value {
  color: var(--ink);
}

.entry {
  margin-top: 32rpx;
  background: var(--card);
  border-radius: var(--radius);
  padding: 30rpx 28rpx;
  display: flex;
  justify-content: space-between;
  font-size: 30rpx;
}

.entry__arrow {
  color: var(--s-3);
}

.profile__avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex: 0 0 120rpx;
  border-radius: 60rpx;
  overflow: hidden;
}

.profile__avatar-btn {
  position: absolute;
  left: 0;
  top: 0;
  width: 120rpx;
  height: 120rpx;
  min-width: 0;
  min-height: 0;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  box-sizing: border-box;
  opacity: 0;
}

.profile__avatar-btn::after {
  border: none;
}

.profile__avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  display: block;
}
