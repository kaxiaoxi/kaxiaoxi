.picker-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1200;
  pointer-events: none;
}

.picker-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  opacity: 0;
  background: rgba(12, 19, 24, 0.34);
  transition: opacity 220ms cubic-bezier(0.2, 0, 0, 1);
  -webkit-backdrop-filter: blur(7px);
  backdrop-filter: blur(7px);
}

.picker-panel {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  bottom: 0;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-bottom: 0;
  border-radius: 38rpx 38rpx 0 0;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    0 -18rpx 60rpx rgba(35, 63, 80, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  opacity: 0;
  transform: translateY(104%);
  transition:
    transform 260ms cubic-bezier(0.2, 0, 0, 1),
    opacity 180ms cubic-bezier(0.2, 0, 0, 1);
  -webkit-backdrop-filter: saturate(150%) blur(24px);
  backdrop-filter: saturate(150%) blur(24px);
}

.picker-root--open {
  pointer-events: auto;
}

.picker-root--open .picker-mask {
  opacity: 1;
}

.picker-root--open .picker-panel {
  opacity: 1;
  transform: translateY(0);
}

.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 12rpx;
}

.picker-title {
  font-size: 34rpx;
  font-weight: 700;
}

.picker-close {
  font-size: 28rpx;
  color: var(--blue, #2e5f7e);
}

.picker-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 8rpx 32rpx 8rpx;
  padding: 0 24rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: rgba(118, 118, 128, 0.1);
}

.picker-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
}

.picker-placeholder {
  color: rgba(60, 60, 67, 0.42);
}

.picker-clear {
  font-size: 24rpx;
  color: var(--blue, #2e5f7e);
}

.picker-list {
  flex: 1;
  max-height: 56vh;
  padding: 8rpx 16rpx 24rpx;
}

.picker-group {
  padding: 20rpx 16rpx 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(60, 60, 67, 0.5);
}

.picker-opt {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 16rpx;
  border-radius: 20rpx;
}

.picker-opt:active {
  background: rgba(118, 118, 128, 0.1);
}

.picker-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.picker-avatar--none {
  background: rgba(118, 118, 128, 0.14);
  color: rgba(60, 60, 67, 0.5);
}

.picker-opt__main {
  flex: 1;
  min-width: 0;
}

.picker-opt__name {
  font-size: 30rpx;
  font-weight: 500;
}

.picker-opt__meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(60, 60, 67, 0.55);
}

.picker-opt__check {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--blue, #2e5f7e);
}

.picker-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.5);
}
