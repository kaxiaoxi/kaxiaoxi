.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(242, 242, 247, 0) 0%,
    rgba(242, 242, 247, 0.34) 42%,
    rgba(242, 242, 247, 0.72) 100%
  );
}

.tabbar {
  position: relative;
  display: flex;
  height: 104rpx;
  padding: 8rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 34rpx;
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.54),
      rgba(255, 255, 255, 0.24) 52%,
      rgba(255, 255, 255, 0.38)
    ),
    rgba(255, 255, 255, 0.2);
  box-shadow:
    0 20rpx 54rpx rgba(44, 76, 94, 0.2),
    0 4rpx 12rpx rgba(44, 76, 94, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.38);
  pointer-events: auto;
  -webkit-backdrop-filter: saturate(185%) blur(26px);
  backdrop-filter: saturate(185%) blur(26px);
}

.tabbar::before {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  top: 1rpx;
  height: 2rpx;
  border-radius: 2rpx;
  content: '';
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.98) 28%,
    rgba(255, 255, 255, 0.72) 72%,
    rgba(255, 255, 255, 0) 100%
  );
}

.tabbar::after {
  position: absolute;
  right: -18rpx;
  bottom: -44rpx;
  width: 156rpx;
  height: 98rpx;
  border-radius: 50%;
  content: '';
  background: radial-gradient(circle, rgba(255, 255, 255, 0.48), rgba(255, 255, 255, 0) 68%);
  pointer-events: none;
}

.tabbar__indicator-track {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 8rpx;
  bottom: 8rpx;
  overflow: hidden;
  border-radius: 27rpx;
  pointer-events: none;
}

.tabbar__indicator {
  width: 25%;
  height: 100%;
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  border-radius: 27rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.58), rgba(46, 95, 126, 0.15));
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82),
    0 8rpx 18rpx rgba(46, 95, 126, 0.1);
  transition: transform 340ms cubic-bezier(0.16, 1, 0.3, 1);
}

.tabbar__item {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  border-radius: 27rpx;
  color: #636366;
  transition: opacity 160ms cubic-bezier(0.2, 0, 0, 1);
}

.tabbar__item--on {
  color: var(--blue);
}

.tabbar__item--pressed {
  opacity: 0.68;
}

.tabbar__content {
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tabbar__icon-stack {
  position: relative;
  width: 42rpx;
  height: 42rpx;
}

.tabbar__icon {
  position: absolute;
  left: 0;
  top: 0;
  width: 42rpx;
  height: 42rpx;
  display: block;
  transition:
    opacity 220ms cubic-bezier(0.2, 0, 0, 1),
    transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
}

.tabbar__icon--idle {
  opacity: 1;
  transform: scale(1);
}

.tabbar__icon--active {
  opacity: 0;
  transform: scale(0.9);
}

.tabbar__item--on .tabbar__icon--idle {
  opacity: 0;
  transform: scale(1.03);
}

.tabbar__item--on .tabbar__icon--active {
  opacity: 1;
  transform: scale(1.03);
}

.tabbar__label {
  font-size: 20rpx;
  line-height: 1;
  font-weight: 500;
  transition: color 200ms cubic-bezier(0.16, 1, 0.3, 1);
}

.tabbar__item--on .tabbar__label {
  font-weight: 600;
}

@media (prefers-reduced-motion: reduce) {
  .tabbar__indicator,
  .tabbar__icon {
    transition-duration: 1ms;
  }
}
