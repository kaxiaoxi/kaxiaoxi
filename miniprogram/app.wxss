@import './styles/variables.wxss';

page {
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 32rpx;
  line-height: 1.45;
}

view,
text,
scroll-view {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.btn {
  height: 96rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn--primary {
  background: var(--blue);
  color: #fff;
}

.btn--ghost {
  background: #fff;
  color: var(--ink);
  border: 1rpx solid var(--sep);
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 32rpx;
}

.muted {
  color: var(--s-2);
  font-size: 26rpx;
}
